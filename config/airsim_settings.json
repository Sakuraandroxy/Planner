{
  "SeeDocsAt": "https://microsoft.github.io/AirSim/settings/",
  "_why": [
    "Planner-owned AirSim settings. /data/airsim/settings.json is shared with",
    "airsim-flight-console and is left untouched.",
    "Scene and DepthPerspective are captured at the SAME resolution because the",
    "shared Observation contract validates depth_m.shape == rgb.shape[:2]",
    "(planner/domain/observation.py). The console-facing file asks for",
    "1920x1080 Scene against 256x256 Depth, which no capture can satisfy.",
    "1280x720 matches the ProjectAirSim rig in config/base.yaml camera.width/height",
    "so both simulator families hand the model the same geometry."
  ],
  "SettingsVersion": 1.2,
  "LogMessagesVisible": false,
  "ClockSpeed": 1,
  "SimMode": "Multirotor",
  "ApiServerPort": 41451,
  "TargetFPS": 60,
  "CameraDefaults": {
    "CaptureSettings": [
      { "ImageType": 0, "FOV_Degrees": 90, "Width": 1280, "Height": 720 },
      { "ImageType": 2, "FOV_Degrees": 90, "Width": 1280, "Height": 720 }
    ]
  },
  "Vehicles": {
    "Drone_1": {
      "VehicleType": "SimpleFlight",
      "AutoCreate": true,
      "Cameras": {
        "front_center": {
          "X": 1, "Y": 0, "Z": 0,
          "Pitch": 0, "Roll": 0, "Yaw": 0,
          "CaptureSettings": [
            { "ImageType": 0, "Width": 1280, "Height": 720, "FOV_Degrees": 90.0 },
            { "ImageType": 2, "Width": 1280, "Height": 720, "FOV_Degrees": 90.0 }
          ]
        },
        "down_center": {
          "X": 0, "Y": 0, "Z": 0,
          "Pitch": -90, "Roll": 0, "Yaw": 0,
          "CaptureSettings": [
            { "ImageType": 0, "Width": 1280, "Height": 720, "FOV_Degrees": 90.0 },
            { "ImageType": 2, "Width": 1280, "Height": 720, "FOV_Degrees": 90.0 }
          ]
        }
      }
    }
  }
}
